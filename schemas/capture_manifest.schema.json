{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Peak Hardware Capture Manifest",
  "type": "object",
  "required": [
    "capture_id",
    "captured_at",
    "peak_os_version",
    "computer_os",
    "connection",
    "midi_channel",
    "cc_nrpn_mode",
    "bank_patch_mode",
    "patch_protect",
    "files"
  ],
  "properties": {
    "capture_id": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "peak_os_version": {
      "type": "string"
    },
    "computer_os": {
      "type": "string"
    },
    "connection": {
      "enum": [
        "USB",
        "DIN"
      ]
    },
    "midi_channel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "cc_nrpn_mode": {
      "enum": [
        "Disabled",
        "Receive",
        "Transmit",
        "Rec+Tran"
      ]
    },
    "bank_patch_mode": {
      "enum": [
        "Disabled",
        "Receive",
        "Transmit",
        "Rec+Tran"
      ]
    },
    "patch_protect": {
      "enum": [
        "On",
        "Off"
      ]
    },
    "notes": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
